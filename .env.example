# Under Komodo these come from the stack Environment (secrets from variables).
TYPEBOT_VERSION=3.19.0

TYPEBOT_BUILDER_URL=https://typebot.example.com
TYPEBOT_VIEWER_URL=https://bot.example.com
TYPEBOT_ADMIN_EMAIL=you@example.com
TYPEBOT_DISABLE_SIGNUP=true
# openssl rand -base64 24
TYPEBOT_ENCRYPTION_SECRET=changeme

# Shared Postgres (postgres_build). Hex password: openssl rand -hex 32
TYPEBOT_DB_HOST=postgres
TYPEBOT_DB_NAME=typebot
TYPEBOT_DB_USER=typebot
TYPEBOT_DB_PASSWORD=changeme
# Shared Redis (redis_build), own DB index. Optional.
# TYPEBOT_REDIS_URL=redis://:<redis password>@redis:6379/1

# SMTP (login links). Example: Resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxx
SMTP_FROM="Typebot <bot@example.com>"

# S3 storage (e.g. Backblaze B2). Endpoint is a bare host.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_ENDPOINT=s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003

DB_NETWORK=db
PROXY_NETWORK=proxy
